# Copy to `backend/.env` and adjust.

PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anantham_nursary

DB_CONN_LIMIT=10
DB_QUEUE_LIMIT=0

JWT_SECRET=dev_secret_change_in_production

# Frontend URL(s) allowed by CORS (omit or leave empty to allow all — dev only)
# CORS_ORIGIN=http://localhost:5173
# Production example:
# CORS_ORIGIN=https://your-live-domain.example
