# Frontend (Vite) — optional overrides (copy to `.env` or `.env.local`).
#
# Default URLs are the local API (see `src/config/urls.js`). You only need this
# file if you run the UI against a local backend.

# Local backend example:
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_SERVER_ORIGIN=http://localhost:5000

# Previous live example (optional override):
# VITE_API_BASE_URL=https://your-live-domain.example/api
# VITE_SERVER_ORIGIN=https://your-live-domain.example
